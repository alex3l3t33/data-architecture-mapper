{
  "name": "orders-mongodb-sink",
  "config": {
    "connector.class": "com.mongodb.kafka.connect.MongoSinkConnector",
    "tasks.max": "2",
    "kafka.cluster": "primary",
    "topics": "orders",
    "connection.uri": "mongodb://mongo-orders-staging.example.test:27017",
    "database": "commerce_staging",
    "collection": "orders",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "orders-mongodb-dlq"
  }
}
